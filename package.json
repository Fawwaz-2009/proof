{
  "name": "starting-flare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "create-starting-flare": "packages/create-starting-flare/src/index.ts"
  },
  "scripts": {
    "dev": "alchemy dev",
    "destroy": "alchemy destroy",
    "build": "cd apps/web && bun run build",
    "typecheck": "tsc -p tsconfig.iac.json && cd apps/backend && bun run typecheck && cd ../web && bun run typecheck",
    "lint": "oxlint",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run build",
    "deploy": "alchemy deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "@effect/platform-bun": "4.0.0-rc.110",
    "@effect/platform-node": "4.0.0-rc.110",
    "@types/bun": "1.3.14",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.110",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "better-auth@1.7.1": "patches/better-auth@1.7.1.patch",
    "kysely@0.29.5": "patches/kysely@0.29.5.patch"
  }
}
