# Optional headless Cloudflare credentials for CI / non-interactive machines.
# Interactive use can rely on `alchemy login` (OAuth) instead. Keep real values
# only in the ignored .env or GitHub secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Better Auth origin allowlist (comma-separated host patterns). The default
# covers localhost and workers.dev previews; add the product domain when the
# product ring goes live.
AUTH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,*.workers.dev

# Verified sender for the sign-in code email (production stages only; every
# non-prod stage captures codes in the development mailbox instead). Must be
# an address on a domain verified in the same Cloudflare account.
AUTH_EMAIL_FROM=Sufra <noreply@localhost>

# Extra hosts allowed to read the development mailbox API. Non-prod stages
# already allow *.workers.dev; localhost requests are always allowed.
DEV_MAILBOX_ALLOWED_HOSTS=
