# proof configuration.
#
# Local development (`alchemy dev`) needs NOTHING in this file: `alchemy
# login` covers Cloudflare auth, and every non-prod stage captures email to
# the logs. Everything below matters when you DEPLOY -- a deploy without a
# required value fails loudly with the key name.
#
# Every variable is optional unless marked "Required to deploy".

# -- Identity (rename your product here, then redeploy) ----------------------
# APP_SLUG is the machine form: it prefixes every public hostname
# (<slug>.<ROOT_DOMAIN>). APP_NAME is what people read: the landing
# wordmark, the page title, the sign-in heading. Both default to the
# template's own identity when unset.
APP_SLUG=
APP_NAME=

# -- Cloudflare auth (optional headless alternative to `alchemy login`) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# -- Required to deploy ------------------------------------------------------
# Optional in spirit, required in practice: the zone (on your Cloudflare
# account) that hosts the app's public hostnames, <slug>.<ROOT_DOMAIN> for
# prod and <slug>-<stage>.<ROOT_DOMAIN> for every other stage. Leave empty
# to deploy on the platform host (<worker>.<account>.workers.dev); set it
# later and redeploy, everything re-derives.
ROOT_DOMAIN=
# R2 S3 credentials (Object Read scope on the Files bucket) used to presign
# image URLs for the browser. The account id is derived from your
# authenticated Cloudflare account, so only the key pair lives here.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Verified sender for the sign-in code email. Only the `prod` stage
# delivers; every other stage captures codes to the logs. The address must
# live on a domain with Email Sending / Routing enabled in the same
# Cloudflare account.
AUTH_EMAIL_FROM=Proof <noreply@yourdomain.com>

# -- Ceremony only (stacks/github.ts) ----------------------------------------
# Where the trust-root stack writes the repo secrets. Owned/written by
# create-proof; edit only when the repo moves.
GITHUB_OWNER=
GITHUB_REPO=
