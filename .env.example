# proof configuration.
#
# Local development (`alchemy dev`) needs NOTHING in this file: `alchemy
# login` covers Cloudflare auth, and every non-prod stage captures email to
# the logs. Everything below matters when you DEPLOY -- a deploy without a
# required value fails loudly with the key name.
#
# Every variable is optional unless marked "Required to deploy".

# -- Identity (rename your product here, then redeploy) ----------------------
# APP_SLUG is the machine form: it prefixes every public hostname
# (<slug>.<ROOT_DOMAIN>). APP_NAME is what people read: the landing
# wordmark, the page title, the sign-in heading. Both default to the
# template's own identity when unset.
# WARNING: rotating the ceremony values (re-running update-stack-secrets)
# deletes and re-mints the CI token and R2 keys. Redeploy any live stage
# afterwards: deployed workers keep the previous keys until then.
APP_SLUG=
APP_NAME=

# -- Cloudflare auth (optional headless alternative to `alchemy login`) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# -- Required to deploy ------------------------------------------------------
# Optional in spirit, required in practice: the zone (on your Cloudflare
# account) that hosts the app's public hostnames, <slug>.<ROOT_DOMAIN> for
# prod and <slug>-<stage>.<ROOT_DOMAIN> for every other stage. Leave empty
# to deploy on the platform host (<worker>.<account>.workers.dev); set it
# later and redeploy, everything re-derives.
ROOT_DOMAIN=
# R2 S3 credentials used to presign image URLs for the browser. You do not
# need them here: the ceremony mints a scoped presign token and writes them
# as repo secrets for CI. Uncomment only for manual local deploys to a real
# stage (alchemy deploy --stage X from this machine).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Verified sender for the sign-in code email. Only the `prod` stage
# delivers; every other stage captures codes to the logs. The address must
# live on a domain with Email Sending / Routing enabled in the same
# Cloudflare account.
# The placeholder below fails the readiness preflight by design (yourdomain.com
# is in the placeholder list): production sign-in cannot deliver codes until a
# real sender on your domain replaces it.
AUTH_EMAIL_FROM=Proof <noreply@yourdomain.com>

# -- Ceremony only (stacks/github.ts) ----------------------------------------
# Where the trust-root stack writes the repo secrets. Owned/written by
# create-proof; edit only when the repo moves.
GITHUB_OWNER=
GITHUB_REPO=

# -- Mobile (apps/mobile) ----------------------------------------------------
# The app reads its own env: identity values mirror the ones above, plus
# EXPO_PUBLIC_API_URL for the stage it talks to. See apps/mobile/.env.example.
# Mobile PR previews additionally need EAS_PROJECT_ID in apps/mobile/.env
# (created once by `bunx eas init` in apps/mobile) and an EXPO_TOKEN secret in
# CI for non-interactive builds and updates. `bun run mobile:doctor` reports
# exactly what is still missing; `mobile-preview.config.ts` decides whether a
# clone publishes mobile previews at all.

# -- Android browser preview (EC2) -------------------------------------------
# Phase 0 feasibility probe: an EC2 host that runs the native app in an
# emulator and streams it to a reviewer's browser. Nothing below is needed by
# a clone that does not run the probe, and each missing value fails loudly by
# name rather than being guessed.
#
# Region has NO default on purpose. It decides the hourly cost, the reviewer's
# latency against the 500 ms budget, and whether the instance family is offered
# there at all, so guessing it would produce a plausible wrong answer. The AWS
# CLI's AWS_REGION / AWS_DEFAULT_REGION are accepted as fallbacks when your
# profile already sets one.
ANDROID_PREVIEW_REGION=
# The Amazon Linux 2023 x86_64 AMI for that region. Per-region, hence pinned
# here rather than in code; the probe records the image it actually ran.
#   aws ssm get-parameter --region "$ANDROID_PREVIEW_REGION" \
#     --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64 \
#     --query Parameter.Value --output text
ANDROID_PREVIEW_AMI_ID=
# Optional. Set it to also create the Cloudflare Tunnel that routes this
# hostname to the host's loopback bridge (the streaming slice). Leave it unset
# for the host-only acceleration probe, which needs no Cloudflare permission
# beyond the state store. Must be in a zone on this Cloudflare account,
# e.g. android-probe.<ROOT_DOMAIN>.
# ANDROID_PREVIEW_PROBE_HOSTNAME=
# Optional. The documented starting point is m7i.xlarge; any family AWS does not
# document as supporting nested virtualization is refused before launch.
# ANDROID_PREVIEW_INSTANCE_TYPE=

# Owner allowed through Cloudflare Access for the disposable browser probe.
# ANDROID_PREVIEW_REVIEWER_EMAIL=
# Automated verification additionally requires Access: Service Tokens Write.
# Set false only to deploy the owner's login independently of that test token.
# ANDROID_PREVIEW_VERIFICATION=true
