# Mobile configuration. Copy to .env (gitignored): cp .env.example .env
#
# Identity mirrors the root .env: the same three values the stack derives
# every hostname from. They name the app, its deep-link scheme, and its
# bundle identifier. Unset values fall back to the template identity.
APP_NAME=
APP_SLUG=
ROOT_DOMAIN=

# The Expo project the one-time EAS ceremony creates. Set it here after the
# ceremony; per-PR OTA updates are published under this project.
# EAS_PROJECT_ID=

# The API the app talks to.
# Local dev: the website URL `bun run dev` prints (the sole ingress).
# Simulator shares the Mac's network, a physical phone needs the Mac's LAN
# IP. PR previews bake their own stage URL at publish time; nothing to set
# for those.
EXPO_PUBLIC_API_URL=
