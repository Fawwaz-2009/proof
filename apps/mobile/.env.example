# Mobile configuration. Generated by `bun run mobile:env` at the repository
# root, which mirrors APP_NAME/APP_SLUG/ROOT_DOMAIN from the repository .env
# (identity must match the deployment: the app config takes part in the
# native runtime fingerprint) and preserves the two values below.
#
# This example file documents the contract; the sync writes the real one.
#
# Identity, mirrored from the repository .env. Empty values fall back to the
# template identity, the same fallback the stack uses.
APP_NAME=
APP_SLUG=
ROOT_DOMAIN=

# The Expo project the one-time EAS ceremony creates. Preserved by the sync.
# EAS_PROJECT_ID=

# The API the app talks to; local-only, preserved by the sync.
# Local dev: the website URL `bun run dev` prints (the sole ingress).
# Simulator shares the Mac's network, a physical phone needs the Mac's LAN
# IP. PR previews bake their own stage URL at publish time; nothing to set
# for those.
EXPO_PUBLIC_API_URL=
